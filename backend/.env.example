# Copy to backend/.env and fill in. That file is gitignored.
# The app loads it at startup; real environment variables always win, so the
# same image works in production where the platform supplies the secrets.

# ── models ────────────────────────────────────────────────────────────────
# "offline" runs the deterministic provider: no keys needed, all tests pass,
# every demo scenario resolves. Switch to a provider for judgement quality.
REZO_LLM_PROVIDER=offline
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# ── email ─────────────────────────────────────────────────────────────────
# Leave REZO_MAIL unset to show the sign-in code on screen instead of sending.
# The from-address domain must be verified with the provider exactly: a key
# that verified example.com cannot send from mail.example.com.
REZO_MAIL=
RESEND_API_KEY=
REZO_MAIL_FROM="Rezo <hello@yourdomain.com>"
REZO_MAIL_REPLY_TO=

# ── voice (not wired yet) ─────────────────────────────────────────────────
ELEVENLABS_API_KEY=
